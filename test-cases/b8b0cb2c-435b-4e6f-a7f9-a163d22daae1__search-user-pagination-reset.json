{
  "id": "search-user-pagination-reset",
  "testPlanId": "b8b0cb2c-435b-4e6f-a7f9-a163d22daae1",
  "requirementId": "908f1846-7913-4d2d-8e70-8e5bc11bdcbd",
  "suiteName": "Admin — User Management SMOKE",
  "case": {
    "id": "search-user-pagination-reset",
    "title": "Search resets pagination to page 1 when query changes",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to admin page with >20 users",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "step2",
        "action": "tap",
        "targetDescription": "Click page 2 in pagination controls",
        "locatorHint": "button:has-text('2')"
      },
      {
        "id": "step3",
        "action": "fill",
        "targetDescription": "Type 'test' in Search user input",
        "locatorHint": "input[placeholder='Search user']",
        "value": "test"
      },
      {
        "id": "step4",
        "action": "assertText",
        "targetDescription": "Pagination is reset to page 1",
        "locatorHint": "button[aria-current='page']",
        "assertion": "1"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
