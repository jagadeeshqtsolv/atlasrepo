    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to admin page as Portal Administrator",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "step2",
        "action": "assertDisabled",
        "targetDescription": "Admin's own Account Access toggle is disabled",
        "locatorHint": "[data-testid='user-toggle-self']"
      },
      {
        "id": "step3",
        "action": "hover",
        "targetDescription": "Hover over Admin's own toggle",
        "locatorHint": "[data-testid='user-toggle-self']"
      },
      {
        "id": "step4",
        "action": "assertVisible",
        "targetDescription": "Tooltip 'You cannot revoke your own access.' is displayed",
        "locatorHint": "[role='tooltip']",
        "assertion": "You cannot revoke your own access."
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
