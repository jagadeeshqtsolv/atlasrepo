{
  "id": "account-access-toggle-on-to-off",
  "testPlanId": "b8b0cb2c-435b-4e6f-a7f9-a163d22daae1",
  "requirementId": "908f1846-7913-4d2d-8e70-8e5bc11bdcbd",
  "suiteName": "Admin — User Management SMOKE",
  "case": {
    "id": "account-access-toggle-on-to-off",
    "title": "Revoke account access for active user (toggle ON to OFF with confirmation)",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to admin page",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "step2",
        "action": "tap",
        "targetDescription": "Click ON toggle for active user",
        "locatorHint": "[data-testid='account-access-toggle-on']"
      },
      {
        "id": "step3",
        "action": "assertVisible",
        "targetDescription": "Confirmation dialog appears",
        "locatorHint": "[role='dialog']"
      },
      {
        "id": "step4",
        "action": "tap",
        "targetDescription": "Click 'Revoke' button in dialog",
        "locatorHint": "button:has-text('Revoke')"
      },
      {
        "id": "step5",
        "action": "assertVisible",
        "targetDescription": "Toggle changes to OFF",
        "locatorHint": "[data-testid='account-access-toggle-off']"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
