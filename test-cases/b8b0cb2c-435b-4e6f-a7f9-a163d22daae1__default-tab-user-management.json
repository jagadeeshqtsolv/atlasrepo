{
  "id": "default-tab-user-management",
  "testPlanId": "b8b0cb2c-435b-4e6f-a7f9-a163d22daae1",
  "requirementId": "908f1846-7913-4d2d-8e70-8e5bc11bdcbd",
  "suiteName": "Admin — User Management SMOKE",
  "case": {
    "id": "default-tab-user-management",
    "title": "User Management tab is active by default with correct columns and user count",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to admin page",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "step2",
        "action": "assertVisible",
        "targetDescription": "User Management tab is active",
        "locatorHint": "tab[aria-selected='true'][name='User Management']"
      },
      {
        "id": "step3",
        "action": "assertText",
        "targetDescription": "Tabs are rendered in correct order",
        "locatorHint": "tablist",
        "assertion": "User ManagementRoles & AccessAudit Log"
      },
      {
        "id": "step4",
        "action": "assertVisible",
        "targetDescription": "\"N Users\" count label is visible",
        "locatorHint": "[data-testid='user-count-label']"
      },
      {
        "id": "step5",
        "action": "assertVisible",
        "targetDescription": "Search user input is visible with correct placeholder",
        "locatorHint": "input[placeholder='Search user']"
      },
      {
        "id": "step6",
        "action": "assertVisible",
        "targetDescription": "Invite user button is visible",
        "locatorHint": "button:has-text('Invite user')"
      },
      {
        "id": "step7",
        "action": "assertText",
        "targetDescription": "Table columns are correct and in order",
        "locatorHint": "thead tr",
        "assertion": "User informationRoleStatusLast activeAccount Access"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
