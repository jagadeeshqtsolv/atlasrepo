      },
      {
        "id": "step3",
        "action": "assertVisible",
        "targetDescription": "Confirmation dialog appears",
        "locatorHint": "[role='dialog']"
      },
      {
        "id": "step4",
        "action": "tap",
        "targetDescription": "Click Cancel button",
        "locatorHint": "button:has-text('Cancel')"
      },
      {
        "id": "step5",
        "action": "assertVisible",
        "targetDescription": "Toggle remains ON",
        "locatorHint": "[data-testid='user-toggle-on']"
      }
    ],
    "tags": [
