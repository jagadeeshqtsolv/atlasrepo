    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to admin page",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "step2",
        "action": "assertDisabled",
        "targetDescription": "Admin's own Account Access toggle is disabled",
        "locatorHint": "[data-testid='account-access-toggle-self']"
      },
      {
        "id": "step3",
        "action": "hover",
        "targetDescription": "Hover over admin's own toggle",
        "locatorHint": "[data-testid='account-access-toggle-self']"
      },
      {
        "id": "step4",
        "action": "assertText",
        "targetDescription": "Tooltip appears with correct message",
        "locatorHint": "[role='tooltip']",
        "assertion": "You cannot revoke your own access."
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
